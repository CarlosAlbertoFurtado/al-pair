# ══════════════════════════════════════════════════════════════
# AuPairConnect - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no repositório!
# ══════════════════════════════════════════════════════════════

# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Banco de Dados (PostgreSQL) ────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/aupairconnect?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Autenticação (JWT) ─────────────────────────────────────
# Gere chaves fortes com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="trocar_por_chave_forte_de_64_bytes"
JWT_REFRESH_SECRET="trocar_por_outra_chave_forte_de_64_bytes"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"

# ─── Upload de Arquivos ─────────────────────────────────────
# CLOUDINARY_URL permite upload persistente e deteccao de rosto para avatar.
# Exemplo: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=""
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
